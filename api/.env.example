# Banco de dados (Postgres)
DATABASE_URL=""

# Autenticacao
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# Servidor
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Gateway de cobranca (boleto/Pix). Enquanto o banco/gateway nao for definido,
# use "fake": ele gera linha digitavel e Pix ficticios para desenvolvimento.
COBRANCA_GATEWAY="fake"

# Canal de mensagens (WhatsApp/SMS/e-mail).
#   "console" apenas registra o envio no log (desenvolvimento).
#   "twilio"  envia WhatsApp e SMS de verdade pela API do Twilio (custo por msg).
MENSAGERIA_PROVIDER="console"

# Credenciais do Twilio — obrigatorias somente quando MENSAGERIA_PROVIDER="twilio".
# Account SID e Auth Token ficam no painel do Twilio (Console > Account Info).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Remetente de WhatsApp aprovado no Twilio (ex.: +14155238886). Vazio desliga WhatsApp.
TWILIO_WHATSAPP_FROM=""
# Remetente de SMS (ex.: +12025550123). Vazio desliga SMS. O Twilio nao envia e-mail.
TWILIO_SMS_FROM=""

# Quem recebe o resumo do ciclo diario de cobranca (separados por virgula).
# Vazio desliga o alerta para a equipe.
EMAILS_DA_EQUIPE=""

# Armazenamento dos anexos (contrato assinado, documentos do cliente).
# "local" grava em disco. ATENCAO: em plataformas com disco efemero (Render,
# Heroku, Fly) os arquivos somem a cada deploy — ali e obrigatorio um provedor
# externo (S3, R2, Backblaze) implementando a porta ArmazenamentoDeArquivos.
ARMAZENAMENTO_ARQUIVOS="local"
ARMAZENAMENTO_DIRETORIO="./arquivos"

# Identidade usada nas mensagens e nos documentos de cobranca
NOME_DA_EMPRESA="Gestrato Loteamentos"
URL_PUBLICA="http://localhost:5173"
# URL publica DA API (ex.: https://gestrato-api.onrender.com). Usada para montar
# o StatusCallback que o Twilio chama ao confirmar entrega/leitura da mensagem.
# Vazio desliga a confirmacao: o envio continua, mas a cobranca fica so "ENVIADA".
URL_BASE_API=""
TZ_NEGOCIO="America/Sao_Paulo"

# Usuario administrador criado pelo seed
SEED_ADMIN_EMAIL""
SEED_ADMIN_SENHA=""
