// Persistencia — detalhe de infraestrutura.
//
// O dominio (src/domain) nao importa nada daqui: os mappers em
// src/infrastructure/persistence/prisma traduzem estas linhas para entidades.
//
// Convencoes:
//   - dinheiro sempre em centavos inteiros (sufixo *Centavos), nunca float;
//   - datas de negocio (vencimento, assinatura) usam @db.Date, sem hora e sem
//     fuso, porque "vence dia 10" nao pode mudar com o timezone do servidor;
//   - carimbos de auditoria (criadoEm, enviadaEm) usam DateTime, pois sao
//     instantes de verdade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- acesso

enum PapelUsuario {
  ADMINISTRADOR
  FINANCEIRO
  VENDEDOR
  CONSULTA
}

model Usuario {
  id           String       @id @default(uuid())
  nome         String
  email        String       @unique
  senhaHash    String
  papel        PapelUsuario @default(CONSULTA)
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@map("usuarios")
}

// ---------------------------------------------------------------- cadastros

model Empresa {
  id             String   @id @default(uuid())
  origemSiengeId String?  @unique
  nome           String
  nomeFantasia   String?
  documento      String?
  email          String?
  telefone       String?
  cidade         String?
  uf             String?
  ativa          Boolean  @default(true)
  observacoes    String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  contasAPagar      ContaAPagar[]
  obras             Obra[]
  centrosDeCusto    CentroDeCusto[]
  documentosFiscais DocumentoFiscal[]

  @@index([nome])
  @@map("empresas")
}

model Obra {
  id                    String    @id @default(uuid())
  origemSiengeId        String?   @unique
  empresaId             String?
  nome                  String
  situacaoOrigem        String?
  tipoObraOrigem        Int?
  areaTotal             Float?
  areaTerreno           Float?
  pavimentos            Int?
  orcamentoBaseCentavos Int?
  inicio                DateTime? @db.Date
  termino               DateTime? @db.Date
  enderecoEntrega       String?
  bairroEntrega         String?
  cepEntrega            String?
  observacoes           String?
  ativa                 Boolean   @default(true)
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt

  empresa        Empresa?        @relation(fields: [empresaId], references: [id])
  centrosDeCusto CentroDeCusto[]
  pedidosCompra  PedidoCompra[]

  @@index([empresaId])
  @@index([nome])
  @@map("obras")
}

model CentroDeCusto {
  id                      String   @id @default(uuid())
  origemSiengeId          String?  @unique
  empresaId               String?
  obraId                  String?
  nome                    String
  categoria               String?
  situacaoOrigem          String?
  usaNaObra               Boolean  @default(false)
  controlaEstoque         Boolean  @default(false)
  percentualAdministracao Float?
  observacoes             String?
  criadoEm                DateTime @default(now())
  atualizadoEm            DateTime @updatedAt

  empresa       Empresa?       @relation(fields: [empresaId], references: [id])
  obra          Obra?          @relation(fields: [obraId], references: [id])
  pedidosCompra PedidoCompra[]

  @@index([empresaId])
  @@index([obraId])
  @@map("centros_de_custo")
}

model UnidadeMedida {
  id             String   @id @default(uuid())
  origemSiengeId String?  @unique
  nome           String
  simbolo        String
  grandeza       String?
  ativa          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  insumos Insumo[]

  @@index([simbolo])
  @@map("unidades_medida")
}

model GrupoInsumo {
  id             String   @id @default(uuid())
  origemSiengeId String?  @unique
  nome           String
  referencia     String?
  tipoOrigem     Int?
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  insumos Insumo[]

  @@map("grupos_insumo")
}

model Insumo {
  id                  String   @id @default(uuid())
  origemSiengeId      String?  @unique
  tabelaOrigem        Int
  codigoOrigem        Int
  unidadeId           String?
  grupoId             String?
  nome                String
  sinonimo            String?
  classificacaoFiscal String?
  tempoEntregaDias    Int?
  ativo               Boolean  @default(true)
  controlaPreco       Boolean  @default(false)
  controlaQuantidade  Boolean  @default(false)
  controlaEstoque     Boolean  @default(true)
  observacoes         String?
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  unidade                UnidadeMedida?         @relation(fields: [unidadeId], references: [id])
  grupo                  GrupoInsumo?           @relation(fields: [grupoId], references: [id])
  precos                 PrecoInsumo[]
  itensPedidosCompra     ItemPedidoCompra[]
  itensMovimentosEstoque ItemMovimentoEstoque[]

  @@index([nome])
  @@index([grupoId])
  @@index([unidadeId])
  @@map("insumos")
}

model PrecoInsumo {
  id                      String    @id @default(uuid())
  origemSiengeId          String?   @unique
  insumoId                String
  codigoPrecoOrigem       Int
  valorCentavos           Int
  precoAutorizadoCentavos Int       @default(0)
  custoMedioCentavos      Int       @default(0)
  ultimoCustoCentavos     Int       @default(0)
  dataPreco               DateTime? @db.Date
  dataAutorizacao         DateTime? @db.Date
  dataUltimoCusto         DateTime? @db.Date
  orcado                  Boolean   @default(true)
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  insumo Insumo @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@index([insumoId, dataPreco])
  @@map("precos_insumo")
}

model DocumentoFiscal {
  id                     String   @id @default(uuid())
  origemSiengeId         String?  @unique
  origemTabela           String
  lancamentoOrigem       Int
  empresaId              String?
  fornecedorId           String?
  clienteId              String?
  numero                 String
  serie                  String
  tipoOrigem             Int
  origemCodigo           String
  emitidoEm              DateTime @db.Date
  registradoEm           DateTime @db.Date
  valorContabilCentavos  Int      @default(0)
  descontoCentavos       Int      @default(0)
  freteCentavos          Int      @default(0)
  seguroCentavos         Int      @default(0)
  outrasDespesasCentavos Int      @default(0)
  baseIcmsCentavos       Int      @default(0)
  icmsCentavos           Int      @default(0)
  ipiCentavos            Int      @default(0)
  issCentavos            Int      @default(0)
  inssCentavos           Int      @default(0)
  irCentavos             Int      @default(0)
  pisCentavos            Int      @default(0)
  cofinsCentavos         Int      @default(0)
  statusOrigem           String?
  chaveAcesso            String?
  observacoes            String?
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  empresa    Empresa?              @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor?           @relation(fields: [fornecedorId], references: [id])
  cliente    Cliente?              @relation(fields: [clienteId], references: [id])
  itens      ItemDocumentoFiscal[]

  @@index([emitidoEm])
  @@index([empresaId])
  @@index([fornecedorId])
  @@index([clienteId])
  @@map("documentos_fiscais")
}

model ItemDocumentoFiscal {
  id                    String   @id @default(uuid())
  origemSiengeId        String?  @unique
  documentoId           String
  sequenciaOrigem       Int
  produto               String?
  ncm                   String?
  cfop                  String?
  unidadeOrigem         Int?
  quantidade            Float    @default(0)
  precoUnitarioCentavos Int      @default(0)
  totalCentavos         Int      @default(0)
  descontoCentavos      Int      @default(0)
  freteCentavos         Int      @default(0)
  seguroCentavos        Int      @default(0)
  baseIcmsCentavos      Int      @default(0)
  icmsCentavos          Int      @default(0)
  ipiCentavos           Int      @default(0)
  pisCentavos           Int      @default(0)
  cofinsCentavos        Int      @default(0)
  observacoes           String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  documento DocumentoFiscal @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
  @@map("itens_documentos_fiscais")
}

model PedidoCompra {
  id                     String   @id @default(uuid())
  origemSiengeId         String?  @unique
  fornecedorId           String?
  obraId                 String?
  centroDeCustoId        String?
  numeroOrigem           Int
  pedidoEm               DateTime @db.Date
  situacaoOrigem         String?
  autorizado             Boolean  @default(false)
  valorItensCentavos     Int      @default(0)
  descontoCentavos       Int      @default(0)
  outrasDespesasCentavos Int      @default(0)
  freteCentavos          Int      @default(0)
  valorTotalCentavos     Int      @default(0)
  condicaoPagamento      String?
  enderecoEntrega        String?
  observacoes            String?
  criadoEm               DateTime @default(now())
  atualizadoEm           DateTime @updatedAt

  fornecedor    Fornecedor?        @relation(fields: [fornecedorId], references: [id])
  obra          Obra?              @relation(fields: [obraId], references: [id])
  centroDeCusto CentroDeCusto?     @relation(fields: [centroDeCustoId], references: [id])
  itens         ItemPedidoCompra[]

  @@index([pedidoEm])
  @@index([fornecedorId])
  @@index([obraId])
  @@map("pedidos_compra")
}

model ItemPedidoCompra {
  id                    String   @id @default(uuid())
  origemSiengeId        String?  @unique
  pedidoId              String
  sequenciaOrigem       Int
  insumoId              String?
  descricao             String
  quantidade            Float    @default(0)
  precoUnitarioCentavos Int      @default(0)
  descontoCentavos      Int      @default(0)
  freteUnitarioCentavos Int      @default(0)
  precoEstimadoCentavos Int      @default(0)
  observacoes           String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  pedido PedidoCompra @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  insumo Insumo?      @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([insumoId])
  @@map("itens_pedidos_compra")
}

model TipoMovimentoEstoque {
  id              String   @id @default(uuid())
  origemSiengeId  String?  @unique
  nome            String
  movimentoOrigem String?
  entrada         Boolean  @default(false)
  saida           Boolean  @default(false)
  calculaCusto    Boolean  @default(false)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  movimentos MovimentoEstoque[]

  @@map("tipos_movimento_estoque")
}

model MovimentoEstoque {
  id              String   @id @default(uuid())
  origemSiengeId  String?  @unique
  documento       String
  numeroOrigem    String
  tipoId          String?
  fornecedorId    String?
  obraOrigemId    Int?
  centroOrigemId  Int?
  obraDestinoId   Int?
  centroDestinoId Int?
  movimentoEm     DateTime @db.Date
  consistente     Boolean  @default(false)
  observacoes     String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  tipo       TipoMovimentoEstoque?  @relation(fields: [tipoId], references: [id])
  fornecedor Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  itens      ItemMovimentoEstoque[]

  @@index([movimentoEm])
  @@index([tipoId])
  @@index([fornecedorId])
  @@map("movimentos_estoque")
}

model ItemMovimentoEstoque {
  id                    String   @id @default(uuid())
  origemSiengeId        String?  @unique
  movimentoId           String
  sequenciaOrigem       Int
  insumoId              String?
  unidadeMovOrigem      Int
  descricao             String
  quantidade            Float    @default(0)
  precoUnitarioCentavos Int      @default(0)
  contaOrigem           String?
  contaDestino          String?
  observacoes           String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  movimento MovimentoEstoque @relation(fields: [movimentoId], references: [id], onDelete: Cascade)
  insumo    Insumo?          @relation(fields: [insumoId], references: [id], onDelete: SetNull)

  @@index([movimentoId])
  @@index([insumoId])
  @@map("itens_movimentos_estoque")
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

model Cliente {
  id             String     @id @default(uuid())
  origemSiengeId String?    @unique
  nome           String
  documento      String     @unique
  tipoPessoa     TipoPessoa
  email          String?
  telefone       String?
  whatsapp       String?
  dataNascimento DateTime?  @db.Date
  logradouro     String     @default("")
  numero         String     @default("")
  complemento    String?
  bairro         String     @default("")
  cidade         String     @default("")
  uf             String     @default("")
  cep            String     @default("")
  observacoes    String?
  ativo          Boolean    @default(true)
  criadoEm       DateTime   @default(now())
  atualizadoEm   DateTime   @updatedAt

  contratos         Contrato[]
  cobrancas         Cobranca[]
  documentosFiscais DocumentoFiscal[]

  @@index([nome])
  @@map("clientes")
}

model Loteamento {
  id                  String   @id @default(uuid())
  origemSiengeId      String?  @unique
  nome                String
  cidade              String
  uf                  String
  registroImobiliario String?
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  quadras                    Quadra[]
  empreendimentosFinanceiros EmpreendimentoFinanceiro[]

  @@map("loteamentos")
}

model Quadra {
  id           String   @id @default(uuid())
  loteamentoId String
  nome         String
  criadoEm     DateTime @default(now())

  loteamento Loteamento @relation(fields: [loteamentoId], references: [id], onDelete: Cascade)
  lotes      Lote[]

  @@unique([loteamentoId, nome])
  @@map("quadras")
}

enum SituacaoLote {
  DISPONIVEL
  RESERVADO
  VENDIDO
  INDISPONIVEL
}

model Lote {
  id                    String       @id @default(uuid())
  origemSiengeId        String?      @unique
  quadraId              String
  numero                String
  areaEmMetrosQuadrados Float
  valorDeTabelaCentavos Int?
  situacao              SituacaoLote @default(DISPONIVEL)
  descricao             String?
  criadoEm              DateTime     @default(now())
  atualizadoEm          DateTime     @updatedAt

  quadra    Quadra     @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@unique([quadraId, numero])
  @@index([situacao])
  @@map("lotes")
}

/// Fora do nucleo de cobranca: guardado apenas para o relatorio de comissao.
model Corretor {
  id                   String   @id @default(uuid())
  nome                 String
  documento            String?  @unique
  email                String?
  telefone             String?
  percentualDeComissao Float    @default(0)
  ativo                Boolean  @default(true)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  contratos Contrato[]

  @@map("corretores")
}

/// Parceiros comerciais que podem indicar vendas, sem vínculo obrigatório com contrato.
model Parceiro {
  id           String   @id @default(uuid())
  nome         String
  documento    String?  @unique
  email        String?
  telefone     String?
  tipo         String   @default("OUTRO")
  observacoes  String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parceiros")
}

// ---------------------------------------------------------------- contas a pagar

model Fornecedor {
  id             String   @id @default(uuid())
  origemSiengeId String?  @unique
  nome           String
  documento      String?  @unique
  email          String?
  telefone       String?
  ativo          Boolean  @default(true)
  observacoes    String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  contasAPagar      ContaAPagar[]
  documentosFiscais DocumentoFiscal[]
  pedidosCompra     PedidoCompra[]
  movimentosEstoque MovimentoEstoque[]

  @@index([nome])
  @@map("fornecedores")
}

enum StatusContaAPagar {
  PENDENTE
  PAGA
  PAGA_PARCIAL
  CANCELADA
}

model ContaAPagar {
  id                    String            @id @default(uuid())
  origemSiengeId        String?           @unique
  fornecedorId          String?
  empresaId             String?
  numeroDocumento       String?
  descricao             String?
  valorOriginalCentavos Int
  valorPagoCentavos     Int               @default(0)
  jurosCentavos         Int               @default(0)
  multaCentavos         Int               @default(0)
  descontoCentavos      Int               @default(0)
  vencimento            DateTime          @db.Date
  status                StatusContaAPagar @default(PENDENTE)
  pagoEm                DateTime?         @db.Date
  formaPagamento        FormaPagamento?
  observacoes           String?
  criadoEm              DateTime          @default(now())
  atualizadoEm          DateTime          @updatedAt

  fornecedor Fornecedor?            @relation(fields: [fornecedorId], references: [id])
  empresa    Empresa?               @relation(fields: [empresaId], references: [id])
  pagamentos PagamentoContaAPagar[]

  @@index([vencimento, status])
  @@index([fornecedorId])
  @@index([empresaId])
  @@map("contas_a_pagar")
}

model PagamentoContaAPagar {
  id               String          @id @default(uuid())
  origemSiengeId   String?         @unique
  contaId          String
  valorCentavos    Int
  jurosCentavos    Int             @default(0)
  multaCentavos    Int             @default(0)
  descontoCentavos Int             @default(0)
  pagoEm           DateTime        @db.Date
  formaPagamento   FormaPagamento?
  observacoes      String?
  criadoEm         DateTime        @default(now())

  conta ContaAPagar @relation(fields: [contaId], references: [id], onDelete: Cascade)

  @@index([contaId, pagoEm])
  @@map("pagamentos_contas_a_pagar")
}

// ---------------------------------------------------------------- contratos

enum Periodicidade {
  MENSAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum StatusContrato {
  ATIVO
  QUITADO
  CANCELADO
  DISTRATADO
}

enum IndiceReajuste {
  NENHUM
  IGPM
  IPCA
  INCC
  INPC
}

enum FormaPagamento {
  DINHEIRO
  PIX
  BOLETO
  TRANSFERENCIA
  CARTAO
  CHEQUE
  PERMUTA
}

model Contrato {
  id             String  @id @default(uuid())
  origemSiengeId String? @unique
  numero         String  @unique
  clienteId      String
  loteId         String
  corretorId     String?

  // Condicoes comerciais — a fonte de onde as parcelas nascem.
  valorTotalCentavos     Int
  valorEntradaCentavos   Int             @default(0)
  dataEntrada            DateTime?       @db.Date
  formaPagamentoEntrada  FormaPagamento?
  quantidadeDeParcelas   Int             @default(0)
  valorDaParcelaCentavos Int?
  primeiroVencimento     DateTime?       @db.Date
  periodicidade          Periodicidade   @default(MENSAL)

  // Politica de mora aplicada as parcelas deste contrato.
  multaPorAtrasoPercentual Float @default(2)
  jurosAoMesPercentual     Float @default(1)
  diasDeCarencia           Int   @default(0)

  indiceReajuste IndiceReajuste @default(NENHUM)
  status         StatusContrato @default(ATIVO)
  dataAssinatura DateTime       @db.Date
  observacoes    String?
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  lote          Lote                  @relation(fields: [loteId], references: [id])
  corretor      Corretor?             @relation(fields: [corretorId], references: [id])
  parcelas      Parcela[]
  pagamentos    Pagamento[]
  cobrancas     Cobranca[]
  documentos    DocumentoDeCobranca[]
  renegociacoes Renegociacao[]
  reajustes     Reajuste[]

  @@index([clienteId])
  @@index([status])
  @@map("contratos")
}

enum StatusParcela {
  PENDENTE
  PAGA
  PAGA_PARCIAL
  CANCELADA
  RENEGOCIADA
}

enum TipoParcela {
  ENTRADA
  FINANCIAMENTO
  RENEGOCIACAO
}

model Parcela {
  id             String      @id @default(uuid())
  origemSiengeId String?     @unique
  contratoId     String
  numero         Int
  tipo           TipoParcela @default(FINANCIAMENTO)

  valorOriginalCentavos Int
  vencimento            DateTime @db.Date

  status                    StatusParcela   @default(PENDENTE)
  valorPagoCentavos         Int             @default(0)
  jurosRecebidosCentavos    Int             @default(0)
  multaRecebidaCentavos     Int             @default(0)
  descontoConcedidoCentavos Int             @default(0)
  pagoEm                    DateTime?       @db.Date
  formaPagamento            FormaPagamento?
  descricao                 String?

  /// Preenchido quando esta parcela foi substituida por um acordo.
  renegociacaoOrigemId String?
  /// Preenchido quando esta parcela nasceu de um acordo.
  renegociacaoId       String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contrato     Contrato              @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  renegociacao Renegociacao?         @relation("ParcelasGeradas", fields: [renegociacaoId], references: [id])
  origemDe     Renegociacao?         @relation("ParcelasSubstituidas", fields: [renegociacaoOrigemId], references: [id])
  pagamentos   Pagamento[]
  cobrancas    Cobranca[]
  documentos   DocumentoDeCobranca[]

  @@unique([contratoId, numero, tipo])
  // Indice que sustenta a regua de cobranca e os paineis de inadimplencia:
  // "todas as parcelas em aberto que vencem/venceram em tal data".
  @@index([status, vencimento])
  @@index([contratoId, vencimento])
  @@map("parcelas")
}

/// Historico de baixas. Uma parcela pode receber varias (pagamento parcial).
model Pagamento {
  id             String  @id @default(uuid())
  origemSiengeId String? @unique
  parcelaId      String
  contratoId     String

  valorPrincipalCentavos Int
  valorJurosCentavos     Int            @default(0)
  valorMultaCentavos     Int            @default(0)
  valorDescontoCentavos  Int            @default(0)
  valorTotalCentavos     Int
  pagoEm                 DateTime       @db.Date
  formaPagamento         FormaPagamento

  /// "MANUAL" ou o nome do provedor que confirmou (webhook de conciliacao).
  origem        String   @default("MANUAL")
  documentoId   String?
  registradoPor String?
  observacoes   String?
  estornado     Boolean  @default(false)
  criadoEm      DateTime @default(now())

  parcela  Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId, pagoEm])
  @@index([pagoEm])
  @@map("pagamentos")
}

// ---------------------------------------------------------------- cobranca

enum Gatilho {
  ANTES_DO_VENCIMENTO
  NO_VENCIMENTO
  APOS_O_VENCIMENTO
}

enum Canal {
  WHATSAPP
  SMS
  EMAIL
}

enum StatusCobranca {
  PENDENTE
  ENVIADA
  FALHA
  CANCELADA
}

/// Configuracao da regua. Uma linha por etapa ("5 dias antes", "10 dias depois").
model EventoDeRegua {
  id              String        @id @default(uuid())
  gatilho         Gatilho
  dias            Int           @default(0)
  canais          Canal[]
  modelo          String
  /// Garante boleto/Pix atualizado antes de enviar a mensagem desta etapa.
  emitirDocumento Boolean       @default(true)
  tipoDeDocumento TipoDocumento @default(BOLETO_COM_PIX)
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  @@unique([gatilho, dias])
  @@map("eventos_de_regua")
}

/// Escala de inadimplencia da loteadora. Tabela de linha unica (id "padrao").
/// Ausente, o sistema usa 8 dias para inadimplencia e 90 para retomada do lote.
model PoliticaDeInadimplencia {
  id                     String   @id @default("padrao")
  diasParaInadimplencia  Int      @default(8)
  diasParaRetomadaDoLote Int      @default(90)
  atualizadoEm           DateTime @updatedAt

  @@map("politica_de_inadimplencia")
}

/// Texto enviado em cada etapa. Editavel pela loteadora sem mexer em codigo.
model ModeloDeMensagem {
  id           String   @id @default(uuid())
  chave        String   @unique
  descricao    String
  assunto      String?
  corpo        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("modelos_de_mensagem")
}

/// Historico completo de cobrancas enviadas — a prova de que o cliente foi notificado.
model Cobranca {
  id         String @id @default(uuid())
  contratoId String
  parcelaId  String
  clienteId  String

  /// `parcelaId:GATILHO:dias` — impede a regua de mandar a mesma etapa duas vezes.
  chaveDeIdempotencia String @unique

  gatilho                 Gatilho
  dias                    Int            @default(0)
  canal                   Canal
  destino                 String
  assunto                 String?
  mensagem                String
  valorCobradoCentavos    Int
  dataDeReferencia        DateTime       @db.Date
  status                  StatusCobranca @default(PENDENTE)
  tentativas              Int            @default(0)
  ultimoErro              String?
  identificadorNoProvedor String?
  criadaEm                DateTime       @default(now())
  enviadaEm               DateTime?

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  parcela  Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([contratoId, criadaEm])
  @@index([parcelaId])
  @@index([status, dataDeReferencia])
  @@map("cobrancas")
}

enum TipoDocumento {
  BOLETO
  PIX
  BOLETO_COM_PIX
}

enum StatusDocumento {
  EMITIDO
  PAGO
  CANCELADO
  EXPIRADO
  FALHA
}

/// Boleto/Pix emitido. Reemissao cria um novo e cancela o anterior.
model DocumentoDeCobranca {
  id         String @id @default(uuid())
  contratoId String
  parcelaId  String

  tipo                 TipoDocumento
  provedor             String
  identificadorExterno String
  nossoNumero          String?
  linhaDigitavel       String?
  codigoDeBarras       String?
  pixCopiaECola        String?
  pixQrCodeBase64      String?
  urlDoDocumento       String?
  valorCentavos        Int
  vencimento           DateTime        @db.Date
  status               StatusDocumento @default(EMITIDO)
  emitidoEm            DateTime        @default(now())
  baixadoEm            DateTime?

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  parcela  Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  @@unique([provedor, identificadorExterno])
  @@index([parcelaId, status])
  @@map("documentos_de_cobranca")
}

/// Eventos crus recebidos do provedor. Guardados antes de processar, para que
/// uma falha de conciliacao possa ser reprocessada sem perder o webhook.
model EventoDeWebhook {
  id                   String    @id @default(uuid())
  provedor             String
  identificadorExterno String
  tipo                 String
  cargaUtil            Json
  processadoEm         DateTime?
  erro                 String?
  recebidoEm           DateTime  @default(now())

  @@unique([provedor, identificadorExterno, tipo])
  @@index([processadoEm])
  @@map("eventos_de_webhook")
}

// ---------------------------------------------------------------- acordos

enum StatusRenegociacao {
  VIGENTE
  CUMPRIDA
  ROMPIDA
  CANCELADA
}

model Renegociacao {
  id         String @id @default(uuid())
  contratoId String

  saldoOriginalCentavos  Int
  encargosCentavos       Int                @default(0)
  descontoCentavos       Int                @default(0)
  valorNegociadoCentavos Int
  entradaCentavos        Int                @default(0)
  dataEntrada            DateTime?          @db.Date
  quantidadeDeParcelas   Int
  primeiroVencimento     DateTime           @db.Date
  periodicidade          Periodicidade      @default(MENSAL)
  status                 StatusRenegociacao @default(VIGENTE)
  motivo                 String?
  acordadoEm             DateTime           @db.Date
  registradoPor          String?
  criadoEm               DateTime           @default(now())
  atualizadoEm           DateTime           @updatedAt

  contrato             Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  parcelasGeradas      Parcela[] @relation("ParcelasGeradas")
  parcelasSubstituidas Parcela[] @relation("ParcelasSubstituidas")

  @@index([contratoId])
  @@map("renegociacoes")
}

// ---------------------------------------------------------------- anexos

enum EscopoDoAnexo {
  CLIENTE
  CONTRATO
}

enum CategoriaDeAnexo {
  RG
  CPF
  COMPROVANTE_RESIDENCIA
  COMPROVANTE_RENDA
  CERTIDAO
  CONTRATO_ASSINADO
  ADITIVO
  TERMO_DE_RENEGOCIACAO
  DISTRATO
  TERMO_DE_QUITACAO
  COMPROVANTE_PAGAMENTO
  OUTRO
}

/// Arquivo enviado pela equipe: contrato assinado, RG, comprovante.
///
/// `donoId` e polimorfico (aponta para cliente OU contrato, conforme `escopo`),
/// entao nao ha chave estrangeira — a existencia do dono e conferida no caso de
/// uso. A alternativa seria duas colunas opcionais com dois FKs, o que espalha
/// `null` por toda consulta em troca de pouca garantia.
///
/// O binario NAO fica aqui: o banco guarda so os metadados e a chave usada para
/// recuperar o conteudo no armazenamento. Guardar arquivo em coluna infla o
/// backup e derruba a performance do resto.
model Anexo {
  id                   String           @id @default(uuid())
  escopo               EscopoDoAnexo
  donoId               String
  categoria            CategoriaDeAnexo
  nomeOriginal         String
  chaveNoArmazenamento String           @unique
  tipoMime             String
  tamanhoBytes         Int
  descricao            String?
  enviadoPor           String?
  enviadoEm            DateTime         @default(now())

  @@index([escopo, donoId])
  @@map("anexos")
}

/// Reajuste anual aplicado as parcelas futuras (IGPM, IPCA, INCC...).
model Reajuste {
  id         String @id @default(uuid())
  contratoId String

  indice            IndiceReajuste
  percentual        Float
  aplicadoAPartirDe DateTime       @db.Date
  parcelasAfetadas  Int
  registradoPor     String?
  criadoEm          DateTime       @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([contratoId])
  @@map("reajustes")
}

// ---------------------------------------------------------------- migracao Sienge

enum StatusImportacaoSienge {
  PREVIA
  EXECUTANDO
  CONCLUIDA
  CONCLUIDA_COM_ERROS
  FALHA
}

/// Auditoria de cada execucao de migracao. A migracao e reexecutavel: os ids
/// de origem nos modelos acima impedem duplicar o que ja foi importado.
model ImportacaoSienge {
  id              String                 @id @default(uuid())
  arquivo         String
  bancoOrigem     String?
  backupEm        DateTime?
  status          StatusImportacaoSienge @default(PREVIA)
  iniciadaEm      DateTime?
  finalizadaEm    DateTime?
  totalLidos      Int                    @default(0)
  totalImportados Int                    @default(0)
  totalIgnorados  Int                    @default(0)
  totalErros      Int                    @default(0)
  resumo          Json?
  criadoEm        DateTime               @default(now())

  registros RegistroImportacaoSienge[]

  @@index([status, criadoEm])
  @@map("importacoes_sienge")
}

enum StatusRegistroImportacaoSienge {
  IMPORTADO
  IGNORADO
  ERRO
}

/// Linha de auditoria do de-para. Guarda a chave original e o motivo de uma
/// eventual rejeicao, sem armazenar documentos pessoais em texto de log.
model RegistroImportacaoSienge {
  id           String                         @id @default(uuid())
  importacaoId String
  tabela       String
  chaveOrigem  String
  entidade     String?
  idDestino    String?
  status       StatusRegistroImportacaoSienge
  mensagem     String?
  criadoEm     DateTime                       @default(now())

  importacao ImportacaoSienge @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@unique([importacaoId, tabela, chaveOrigem])
  @@index([tabela, status])
  @@map("registros_importacao_sienge")
}

// ---------------------------------------------------------------- fluxo de caixa (tesouraria)
//
// Cadastros-base do controle de fluxo de caixa que hoje vive em planilha:
// as contas bancarias (Sicoob, Sicredi...), os socios que fazem aportes, os
// empreendimentos (centros de custo do orcamento) e o plano de categorias
// (rubricas de receita, aporte e despesa). Estes cadastros sao a fundacao dos
// lancamentos e do painel de fluxo de caixa que entram nas fases seguintes.

/// Direcao do dinheiro no fluxo de caixa.
enum TipoLancamentoFinanceiro {
  ENTRADA
  SAIDA
}

/// Classe da rubrica no fluxo de caixa — espelha os grupos da planilha
/// (recebiveis de venda, aportes, despesas fixas/variaveis, custo de obra).
enum NaturezaFinanceira {
  RECEBIVEL_VENDA
  APORTE
  TRANSFERENCIA
  DESPESA_FIXA
  DESPESA_VARIAVEL
  CUSTO_OBRA
  OUTRO
}

/// Conta bancaria da loteadora. O saldo corrente nao e gravado: nasce do saldo
/// inicial mais os lancamentos, sempre em relacao a uma data — mesma decisao de
/// "estado derivado, nao gravado" adotada em parcelas/inadimplencia.
model ContaBancaria {
  id                   String   @id @default(uuid())
  nome                 String
  instituicao          String?
  agencia              String?
  numero               String?
  saldoInicialCentavos Int      @default(0)
  ativa                Boolean  @default(true)
  observacoes          String?
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@index([nome])
  @@map("contas_bancarias")
}

/// Socio/investidor que faz aportes mensais de capital.
model SocioAportador {
  id           String   @id @default(uuid())
  nome         String
  documento    String?
  ativo        Boolean  @default(true)
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([nome])
  @@map("socios_aportadores")
}

/// Empreendimento / centro de custo do orcamento (a Sede administrativa e cada
/// loteamento). Dimensao pela qual as despesas sao agrupadas na planilha.
model EmpreendimentoFinanceiro {
  id           String   @id @default(uuid())
  nome         String
  loteamentoId String?
  ativo        Boolean  @default(true)
  observacoes  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  loteamento Loteamento? @relation(fields: [loteamentoId], references: [id])

  @@index([nome])
  @@map("empreendimentos_financeiros")
}

/// Rubrica do plano de contas do fluxo de caixa (aluguel, energia, salarios,
/// impostos, aportes, recebiveis...). Compartilhada entre empreendimentos: o
/// empreendimento e escolhido no lancamento, nao fixado na categoria.
model CategoriaFinanceira {
  id           String                   @id @default(uuid())
  nome         String
  tipo         TipoLancamentoFinanceiro
  natureza     NaturezaFinanceira
  ordem        Int                      @default(0)
  ativa        Boolean                  @default(true)
  observacoes  String?
  criadoEm     DateTime                 @default(now())
  atualizadoEm DateTime                 @updatedAt

  @@index([natureza])
  @@map("categorias_financeiras")
}
